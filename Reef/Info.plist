<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Reef</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSAudioCaptureUsageDescription</key>
	<string>Reef reads the audio levels of what is playing to draw a live waveform.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Reef shows a live activity when AirPods, headphones, or other Bluetooth devices connect.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Reef shows your next event in the island and a reminder before it starts.</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Sadiq Khan. MIT License.</string>
	<key>NSLocationUsageDescription</key>
	<string>Reef uses your approximate location to show local weather in the island.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Reef uses your approximate location to show local weather in the island.</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSSupportsAutomaticTermination</key>
	<true/>
	<key>NSSupportsSuddenTermination</key>
	<true/>
</dict>
</plist>
