<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Reef is not sandboxed. The overlay is a non-activating panel that
         floats over other apps and joins every Space, which the sandbox does
         not allow. Later features (media info, Bluetooth device battery) also
         read system state that the sandbox blocks. This file is here so a
         signed build can carry extra entitlements if a future feature needs
         one. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
    <!-- Allow the hardened runtime to load the embedded third-party frameworks
         (Sparkle, Vortex, MediaRemoteAdapter) when the app is only ad-hoc
         signed. Without this, library validation rejects them ("different Team
         IDs") and the Release build crashes on launch. A Developer ID +
         notarized build signs everything with one team and would not need it. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
